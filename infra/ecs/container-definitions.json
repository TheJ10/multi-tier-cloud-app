[
  {
    "name": "backend",
    "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/mta-backend:latest"
    "essential": true,
    "portMappings": [
      {
        "containerPort": 8000,
        "hostPort": 8000,
        "protocol": "tcp"
      }
    ],
    "command": [
      "uvicorn",
      "app.main:app",
      "--host",
      "0.0.0.0",
      "--port",
      "8000",
      "--workers",
      "2"
    ]
  }
]
